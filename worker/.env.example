# Minimo necessario aqui. O restante (Zimbra, chave da Anthropic, SMTP, limites) pode ser
# preenchido no site: ComplyFlow > Demandas Juridicas > Configuracao > Conexao.
# Valores definidos neste arquivo tem prioridade sobre os do site.

# Zimbra (IMAP)
ZIMBRA_HOST=mail.seudominio.com.br
ZIMBRA_PORT=993
ZIMBRA_USER=juridico@seudominio.com.br
ZIMBRA_PASSWORD=
ZIMBRA_MAILBOX=INBOX
# Pasta para onde mover e-mails ja processados (crie no Zimbra). Deixe vazio para apenas marcar como lido.
ZIMBRA_PROCESSED_FOLDER=Processados

# Supabase (use a service_role key, nunca exponha no front-end)
SUPABASE_URL=https://ysfatbnndfcmintffrki.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# ID da empresa-cliente (ComplyFlow) dona desta caixa de e-mail. Frisa:
EMPRESA_CLIENTE_ID=0b4ce53b-dadc-4fcb-a9ab-551934b92271

# IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resposta automatica (SMTP do Zimbra). Se vazio, reaproveita host/usuario/senha do IMAP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Trava geral: so envia respostas se for "true". Comece com false e teste em modo sombra.
AUTO_REPLY_ENABLED=false
# Confianca minima da IA para enviar sozinha (0 a 1)
AUTO_REPLY_MIN_CONFIDENCE=0.85
# Maximo de respostas automaticas por remetente em 24h
AUTO_REPLY_MAX_PER_SENDER_DAY=2

# Pedido automatico de documentos (so envia em dia util e horario comercial)
DOCS_REQUEST_ENABLED=false
DOCS_REMINDER_DAYS=3
DOCS_MAX_REMINDERS=2
BUSINESS_HOUR_START=8
BUSINESS_HOUR_END=18
TIMEZONE=America/Sao_Paulo

# Operacao
POLL_INTERVAL_SECONDS=120
MAX_BODY_CHARS=20000
